FINN_DATABASE_URL=sqlite:///./data/finn.db
FINN_LLM_PROVIDER=openai_compatible
FINN_LLM_BASE_URL=
FINN_LLM_API_KEY=
FINN_LLM_MODEL=
FINN_MARKET_CACHE_MINUTES=60
FINN_ANNOUNCEMENT_CACHE_MINUTES=15
# Empty uses the same-origin Next.js API proxy (recommended for LAN/mobile testing).
NEXT_PUBLIC_API_URL=
FINN_BACKEND_URL=http://127.0.0.1:8000
# Add the LAN hostname/IP here if using `next dev` from another device.
FINN_ALLOWED_DEV_ORIGINS=
